{
  // Mirrors the strictest common consumer setup (Vite's react-ts template) so registry code compiles anywhere.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "types": [],
    "incremental": false
  },
  "include": [
    "components/dentil/data-table/**/*.ts",
    "components/dentil/data-table/**/*.tsx",
    "components/dentil/modals/**/*.ts",
    "components/dentil/modals/**/*.tsx",
    "components/dentil/sheets/**/*.ts",
    "components/dentil/sheets/**/*.tsx",
    "components/dentil/date-picker/**/*.ts",
    "components/dentil/date-picker/**/*.tsx",
    "components/dentil/date/**/*.ts",
    "components/dentil/date/**/*.tsx",
    "components/dentil/object-timeline/**/*.ts",
    "components/dentil/object-timeline/**/*.tsx",
    "components/dentil/invoice-table/**/*.ts",
    "components/dentil/invoice-table/**/*.tsx",
    "components/dentil/select-search/**/*.ts",
    "components/dentil/select-search/**/*.tsx",
    "components/dentil/async-select/**/*.ts",
    "components/dentil/async-select/**/*.tsx",
    "components/dentil/country-select/**/*.ts",
    "components/dentil/country-select/**/*.tsx",
    "components/dentil/address-input/**/*.ts",
    "components/dentil/address-input/**/*.tsx",
    "components/dentil/phone-input/**/*.ts",
    "components/dentil/phone-input/**/*.tsx",
    "components/dentil/currency-input/**/*.ts",
    "components/dentil/currency-input/**/*.tsx",
    "components/dentil/dob-input/**/*.ts",
    "components/dentil/dob-input/**/*.tsx",
    "components/dentil/color-picker/**/*.ts",
    "components/dentil/color-picker/**/*.tsx",
    "components/dentil/switch-label/**/*.ts",
    "components/dentil/switch-label/**/*.tsx"
  ]
}
